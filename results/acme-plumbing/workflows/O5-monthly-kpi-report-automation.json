        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMAIL_API_URL }}/records",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "7cb740d0-283d-5b3d-a626-7dee09c69749",
      "name": "Do the routine in email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
